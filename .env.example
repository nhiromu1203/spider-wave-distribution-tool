# Supabase プロジェクトの Settings > API から取得して .env.local にコピーしてください
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...

# ────────────────────────────────────────────────────────────
# 建物データの取得元
#   mock         … 開発用モックデータ（荒川区16件）。開発環境の既定値
#   external_api … 外部建物データ API。下の接続先設定が必要
# 未指定の場合、開発環境は mock、本番環境は external_api になる
# （本番でモックへ自動フォールバックすることはない）
# ────────────────────────────────────────────────────────────
#   scraping     … HTML一覧ページからの取得（自動取得が許可されたサイトのみ）
BUILDING_DATA_SOURCE=mock

# scraping を使う場合のみ設定する
# 取得先は lib/data-sources/scraping/sites.ts の SCRAPING_SITES に登録する
# （利用規約と robots.txt を確認し compliance を埋めないと動作しない）
# SCRAPING_SITE_ID=example-open-data

# csv を使う場合の保存先（既定: <プロジェクト>/data/buildings）
# BUILDING_CSV_DIR=/path/to/building-csv

# external_api を使う場合のみ設定する（未設定なら画面に「未設定」と明示される）
# BUILDING_API_BASE_URL=https://api.example.com
# BUILDING_API_KEY=...
# BUILDING_API_TIMEOUT_MS=10000
# API キーが不要な提供元（公的オープンデータ等）の場合は false にする
# BUILDING_API_REQUIRES_KEY=false

# 本番環境で開発用モックデータを許可する場合のみ 1（通常は設定しない）
# ALLOW_MOCK_DATA_IN_PRODUCTION=1
